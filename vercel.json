{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/aspect-ratio",
      "destination": "/tools/aspect-ratio/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/tools/fabula-ultima-fichas/(data|personajes)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "tools/fabula-ultima-fichas/{data,assets/js,servidor}/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/discord/",
      "destination": "/api/discord"
    },
    {
      "source": "/api/auth/",
      "destination": "/api/auth"
    },
    {
      "source": "/api/datos/",
      "destination": "/api/datos"
    }
  ]
}
